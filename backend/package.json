{
  "name": "gta-v-map-backend",
  "version": "1.0.0",
  "description": "Local GTA V Map API",
  "main": "dist/backend/src/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/backend/src/index.js",
    "import-data": "tsx src/db/import.ts",
    "reset-progress": "tsx src/progress/reset.ts",
    "types": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "verify:import": "tsx tests/real-import.ts",
    "lint": "eslint src tests",
    "generate": "json2ts -i ../schemas/dataset.schema.json -o ../schemas/dataset.d.ts --bannerComment ''"
  },
  "dependencies": {
    "ajv": "^8.17.1",
    "better-sqlite3": "^11.0.0",
    "cors": "^2.8.5",
    "express": "^4.18.2",
    "sharp": "^0.35.4"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.8",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^20.11.0",
    "eslint": "^9.39.1",
    "json-schema-to-typescript": "^15.0.4",
    "tsx": "^4.7.0",
    "typescript": "^5.3.3",
    "typescript-eslint": "^8.46.4"
  }
}
